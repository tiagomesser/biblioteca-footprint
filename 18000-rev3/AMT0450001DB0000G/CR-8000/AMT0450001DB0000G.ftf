(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad c420
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 210000
            (pt 0 0)
          )
        )
      )
      (pad r420_420
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 420000)
            (height 420000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c420h280
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 140000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c420))
          (noconnect (pad c420))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c420))
          (noconnect (pad c420))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c420))
          (noconnect (pad c420))
        )
        (padSet (footLayer Inner)
          (clearance (pad c420))
          (connect (pad c420))
          (noconnect (pad c420))
        )
        (padSet (footLayer Bottom)
          (connect (pad c420))
          (noconnect (pad c420))
        )
      )
      (padstack r420_420h280
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 140000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad r420_420))
          (noconnect (pad r420_420))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r420_420))
          (noconnect (pad r420_420))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad r420_420))
          (noconnect (pad r420_420))
        )
        (padSet (footLayer Inner)
          (clearance (pad r420_420))
          (connect (pad r420_420))
          (noconnect (pad r420_420))
        )
        (padSet (footLayer Bottom)
          (connect (pad r420_420))
          (noconnect (pad r420_420))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "AMT0450001DB0000G"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -100000 1110000
                        (width 10000)
                      )
                      (pt 1100000 1110000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 1100000 1110000
                        (width 10000)
                      )
                      (pt 1100000 -60000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 1100000 -60000
                        (width 10000)
                      )
                      (pt -100000 -60000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -100000 -60000
                        (width 10000)
                      )
                      (pt -100000 1110000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
              (area
                (geometry
                  (surface
                    (outlineWidth 0)
                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 1310000 1360000)
                    (pt 1310000 -310000)
                    (pt -310000 -310000)
                    (pt -310000 1360000)
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -100000 825000
                        (width 20000)
                      )
                      (pt -100000 275000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 1100000 825000
                        (width 20000)
                      )
                      (pt 1100000 225000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 250000 -60000
                        (width 20000)
                      )
                      (pt 750000 -60000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 250000 1110000
                        (width 20000)
                      )
                      (pt 750000 1110000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 0 -250000
                        (width 10000)
                      )
                      (pt 0 -250000
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt 0 -250000
                            (width 10000)
                          )
                        )
                        (center 0 -1073741824)
                        (end
                          (pt 0 -260000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CCW
                        (r 5000)
                        (begin
                          (pt 0 -260000
                            (width 10000)
                          )
                        )
                        (center 0 1073741824)
                        (end
                          (pt 0 -250000
                            (width 10000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt 0 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 0)
                  (angle 90)
                  (padstackGroup default (padstack r420_420h280))
                )
              )
            )
          )
          (pin 2
            (pt 1000000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 1000000 0)
                  (angle 90)
                  (padstackGroup default (padstack c420h280))
                )
              )
            )
          )
          (pin 3
            (pt 1000000 1050000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 1000000 1050000)
                  (angle 90)
                  (padstackGroup default (padstack c420h280))
                )
              )
            )
          )
          (pin 4
            (pt 0 1050000)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 0 1050000)
                  (angle 90)
                  (padstackGroup default (padstack c420h280))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape AMT0450001DB0000G.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

