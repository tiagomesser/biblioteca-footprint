FILE_TYPE=LIBRARY_PARTS;
PRIMITIVE 'LM2904WYDT','LM2904WYDT_Small Outline Packages';
  PIN
    'OUTPUT_A':
      PIN_NUMBER='(1)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'INVERTING_INPUT_A':
      PIN_NUMBER='(2)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'NON-INVERTING_INPUT_A':
      PIN_NUMBER='(3)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'VCC-':
      PIN_NUMBER='(4)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'VCC+':
      PIN_NUMBER='(8)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'OUTPUT_B':
      PIN_NUMBER='(7)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'INVERTING_INPUT_B':
      PIN_NUMBER='(6)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
    'NON-INVERTING_INPUT_B':
      PIN_NUMBER='(5)';
      NO_LOAD_CHECK=BOTH;
      NO_IO_CHECK=BOTH;
      ALLOW_CONNECT=TRUE;
      PINUSE='UNSPEC';
  END_PIN;
  BODY
    PART_NAME='LM2904WYDT';
    PHYS_DES_PREFIX='IC';
    NO_LOAD_CHECK='TRUE';
    PIN_COUNT='8';
    BODY_NAME='LM2904WYDT';
    JEDEC_TYPE='SOIC127P600X175-8M';
  END_BODY;
END_PRIMITIVE;
END.
